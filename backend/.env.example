POSTGRES_DB=ai_code_review_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_code_review_assistant

REDIS_URL=redis://localhost:6379/0
DRAMATIQ_REDIS_MAINTENANCE_CHANCE=100000

GITHUB_ACCESS_TOKEN=replace-with-a-github-token
GITHUB_WEBHOOK_SECRET=replace-with-a-webhook-secret
# Privacy: review and fix prompts send selected repository and pull-request
# content—including private code—to this external model provider. Read
# ../PRIVACY.md and obtain repository-owner approval before deployment.
GOOGLE_API_KEY=replace-with-a-google-api-key
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_MODEL_DEADLINE_SECONDS=120

# Run `python -m app.data_retention` daily to enforce these content windows.
SOURCE_SNIPPET_RETENTION_DAYS=30
REVIEW_DATA_RETENTION_DAYS=365

# Dashboard login. Add the GitHub username permitted to administer this instance.
GITHUB_CLIENT_ID=replace-with-a-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-a-github-oauth-client-secret
ALLOWED_GITHUB_USERS=replace-with-your-github-username
# Set true for HTTPS deployments. Local HTTP development must remain false.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
# When the backend is accessed directly on port 8000, use the frontend URL below.
# For Docker/Nginx, keep this as / because /api is served from the frontend origin.
LOGIN_SUCCESS_REDIRECT=http://localhost:5173/

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password
